# ─────────────────────────────────────────────
#  PolyVoice AI — Environment Configuration
# ─────────────────────────────────────────────

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Translation Provider ---
# Options: "google_free", "google", "microsoft", "libre", "mock"
TRANSLATION_PROVIDER=google_free

# Google Cloud Translation
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# Microsoft Azure Translator
AZURE_TRANSLATOR_KEY=your_azure_translator_key_here
AZURE_TRANSLATOR_REGION=eastus
AZURE_TRANSLATOR_ENDPOINT=https://api.cognitive.microsofttranslator.com

# LibreTranslate (self-hosted or public)
LIBRE_TRANSLATE_URL=https://libretranslate.com
LIBRE_TRANSLATE_API_KEY=your_libre_api_key_here

# --- Text-to-Speech Provider ---
# Options: "google", "azure", "elevenlabs", "browser", "mock"
TTS_PROVIDER=browser

# Google Cloud Text-to-Speech
GOOGLE_TTS_API_KEY=your_google_tts_api_key_here

# Azure Speech Service
AZURE_SPEECH_KEY=your_azure_speech_key_here
AZURE_SPEECH_REGION=eastus

# ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# --- Language Detection ---
# Options: "lingua", "fasttext", "mock"
DETECTION_PROVIDER=lingua

# --- Summarization Provider ---
# Options: "openai", "none"
SUMMARIZATION_PROVIDER=none
OPENAI_API_KEY=your_openai_api_key_here

# --- Limits ---
MAX_TEXT_LENGTH=10000
MAX_REQUESTS_PER_MINUTE=60
